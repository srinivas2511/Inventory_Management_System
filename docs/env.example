# Spring Manufacturing IMS — environment variable template
# Copy to docker/.env (or set in your container runtime / secrets manager).
# NEVER commit .env to version control — add it to .gitignore.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://db:5432/ims
DB_USER=ims
DB_PASSWORD=change_me_strong_password_here
POSTGRES_DB=ims
POSTGRES_USER=ims
POSTGRES_PASSWORD=change_me_strong_password_here
DB_POOL_MAX=20
DB_POOL_MIN=5

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters; generate with: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32_at_minimum
JWT_ACCESS_MINUTES=15

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://ims.yourdomain.com

# ── Mail (password reset) ─────────────────────────────────────────────────────
MAIL_HOST=smtp.yourdomain.com
MAIL_PORT=587
MAIL_USER=noreply@yourdomain.com
MAIL_PASSWORD=change_me_mail_password

# ── Swagger / OpenAPI ─────────────────────────────────────────────────────────
# Set to true only in staging/development; leave false in production
SWAGGER_ENABLED=false

# ── Demo data (dev/demo profile only) ────────────────────────────────────────
# Set to true to auto-seed demo master data and a complete end-to-end workflow
IMS_DEMO_LOAD_DATA=false

# ── Spring profile ────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
