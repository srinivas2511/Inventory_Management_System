{
  "manifest_version": 3,
  "name": "IMS Tally Bridge",
  "version": "1.0.0",
  "description": "Push IMS approved vouchers to Tally Prime from your browser",
  "permissions": ["storage", "activeTab", "alarms"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IMS Tally Bridge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
