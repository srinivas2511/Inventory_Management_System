# Copy to docker/.env and fill in. NEVER commit docker/.env.
DB_NAME=ims
DB_USER=ims
DB_PASSWORD=change-me-to-a-long-random-value
CORS_ORIGINS=https://ims.example.com
WEB_PORT=80
# Required since Phase 1 (login). Generate with:  openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-characters
# Public URL of the web app; password-reset e-mails link to <APP_BASE_URL>/reset-password/<token>
APP_BASE_URL=https://ims.example.com
# First Admin account, created only on a fresh database (empty users table). The password is temporary: the Admin
# must change it at first sign-in. Clear these two after the first start.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-Temporary-1!
# BOOTSTRAP_ADMIN_USERNAME=admin
# SMTP relay used for password-reset e-mails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_AUTH=true
# SMTP_STARTTLS=true
